        const positivePhrases = [
            "أحسنت يا بطل! إجابة سديدة ومثالية 🎁",
            "رائع جداً! معرفتك بالصدقات تنير دربك 🎁",
            "ممتاز! عمل صالح وإجابة صحيحة 👏",
            "إجابة موفقة! استمر في التميز والتقدم 🚀",
            "بارَك الله فيك! خطواتك نحو النجاح ثابتة 💪"
        ];

        const encouragingPhrases = [
            "لا بأس يا بطل! تعلمت المعلومة الصحيحة الآن 🌱",
            "محاولة طيبة! فقدت روحاً واحدة ولكن الرحلة مستمرة 💪",
            "ركز أكثر في الباب القادم، فالمغامرة لم تنتهِ بعد! ☀️",
            "كل خطوة هي درس مفيد، استجمع قواك وانطلق! 🚀"
        ];

        let playerName = '';
        let score = 0;
        let lives = 3;
        let openedDoorsCount = 0;
        let doorStates = Array(15).fill(false); // track opened doors
        let currentActiveDoorIndex = -1;
        let isOpeningDoor = false;

        function startGame() {
            const input = document.getElementById('studentNameInput');
            const name = input.value.trim();
            if (!name) {
                alert('يرجى إدخال اسم الطالب أولاً للبدء!');
                return;
            }
            playerName = name;
            document.getElementById('displayName').innerText = playerName;
            closeModal('welcomeModal');
            
            getAudioContext();
            resetGameState();
        }

        function resetGameState() {
            score = 0;
            lives = 3;
            openedDoorsCount = 0;
            doorStates = Array(15).fill(false);
            isOpeningDoor = false;

            updateHeaderUI();
            renderDoorsGrid();
        }

        function updateHeaderUI() {
            document.getElementById('scoreDisplay').innerText = score;
            document.getElementById('livesDisplay').innerText = '❤️'.repeat(lives) || '💀';
            document.getElementById('progressSubtitle').innerText = `الأبواب المفتوحة: ${openedDoorsCount} من 15 | المتبقي: ${15 - openedDoorsCount}`;
        }

        function renderDoorsGrid() {
            const grid = document.getElementById('doorsGrid');
            grid.innerHTML = '';

            for (let i = 0; i < 15; i++) {
                const doorWrap = document.createElement('div');
                doorWrap.className = `door-wrapper ${doorStates[i] ? 'opened completed' : ''}`;
                doorWrap.id = `door_${i}`;
                doorWrap.onclick = () => handleDoorClick(i);

                doorWrap.innerHTML = `
                    <div class="door-frame">
                        <div class="door-inner-light"></div>
                        <div class="door-status-icon" id="preview_${i}">${doorStates[i] ? '✅' : '📜'}</div>
                        <div class="door-leaf">
                            <div class="door-pattern">
                                <span class="door-number">${i + 1}</span>
                                <div class="door-knob"></div>
                            </div>
                        </div>
                    </div>
                `;
                grid.appendChild(doorWrap);
            }
        }

        function handleDoorClick(index) {
            if (isOpeningDoor || doorStates[index] || lives <= 0) return;
            isOpeningDoor = true;
            currentActiveDoorIndex = index;

            playSound('door');

            const doorEl = document.getElementById(`door_${index}`);
            doorEl.classList.add('opened');

            setTimeout(() => {
                showQuestionModal(questionsList[index]);
            }, 750);
        }

        function showQuestionModal(qData) {
            const qTitle = document.getElementById('questionTitle');
            const qText = document.getElementById('questionText');
            const optionsContainer = document.getElementById('optionsContainer');

            qTitle.innerText = `الباب رقم (${currentActiveDoorIndex + 1})`;
            qText.innerText = qData.text;
            optionsContainer.innerHTML = '';

            if (qData.type === 'tf') {
                const btnTrue = document.createElement('button');
                btnTrue.className = 'option-btn';
                btnTrue.innerHTML = '<span>✅ عبارة صحيحة</span> <span>(صح)</span>';
                btnTrue.onclick = () => checkAnswer(true, qData.answer);

                const btnFalse = document.createElement('button');
                btnFalse.className = 'option-btn';
                btnFalse.innerHTML = '<span>❎ عبارة خاطئة</span> <span>(خطأ)</span>';
                btnFalse.onclick = () => checkAnswer(false, qData.answer);

                optionsContainer.appendChild(btnTrue);
                optionsContainer.appendChild(btnFalse);
            } else if (qData.type === 'mc') {
                qData.options.forEach(opt => {
                    const btn = document.createElement('button');
                    btn.className = 'option-btn';
                    btn.innerHTML = `<span>${opt.text}</span>`;
                    btn.onclick = () => checkAnswer(opt.correct, true);
                    optionsContainer.appendChild(btn);
                });
            }

            openModal('questionModal');
        }

        function checkAnswer(userChoice, correctAnswer) {
            closeModal('questionModal');
            const isCorrect = (userChoice === correctAnswer);

            // Mark door as completed
            doorStates[currentActiveDoorIndex] = true;
            openedDoorsCount++;
            
            const doorEl = document.getElementById(`door_${currentActiveDoorIndex}`);
            if (doorEl) doorEl.classList.add('completed');

            if (isCorrect) {
                playSound('correct');
                const addedPts = 100;
                score += addedPts;
                showScorePop(`+${addedPts}`);
                spawnParticles(window.innerWidth / 2, window.innerHeight / 2, '#2ecc71');

                const msg = positivePhrases[Math.floor(Math.random() * positivePhrases.length)];
                showFeedbackModal('🎉 إجابة صحيحة!', msg, '🎁');
            } else {
                playSound('wrong');
                lives -= 1;
                const msg = encouragingPhrases[Math.floor(Math.random() * encouragingPhrases.length)];
                showFeedbackModal('💔 إجابة خاطئة (-روح)', msg, '🍂');
            }

            updateHeaderUI();
        }

        function showFeedbackModal(title, text, icon) {
            document.getElementById('feedbackTitle').innerText = title;
            document.getElementById('feedbackText').innerText = text;
            document.getElementById('feedbackIcon').innerText = icon;
            openModal('feedbackModal');
        }

        function closeFeedbackAndNext() {
            closeModal('feedbackModal');
            isOpeningDoor = false;

            if (lives <= 0) {
                handleGameOver(false);
            } else if (openedDoorsCount >= 15) {
                handleGameOver(true);
            }
        }

        function handleGameOver(isWin) {
            saveGameRecord(isWin);

            if (isWin) {
                playSound('win');
                document.getElementById('endIcon').innerText = '✏️';
                document.getElementById('endTitle').innerText = 'مبروك البطل العظيم!';
                document.getElementById('endText').innerText = `تهانينا يا ${playerName}! نجحت في فتح كافة الأبواب الـ 15 وإنجاز التحدي كاملًا بنجاح.\nالنتيجة النهائية: ${score} نقطة.`;
            } else {
                playSound('wrong');
                document.getElementById('endIcon').innerText = '💔';
                document.getElementById('endTitle').innerText = 'انتهت الأرواح!';
                document.getElementById('endText').innerText = `للأسف يا ${playerName}، فقدت جميع أرواحك قبل إكمال جميع الأبواب.\nحاول مرة أخرى لتحصل على نتيجة أفضل!`;
            }

            openModal('endModal');
        }

        function resetGame() {
            closeModal('endModal');
            resetGameState();
        }

        function showScorePop(text) {
            const pop = document.getElementById('scorePop');
            pop.innerText = text;
            pop.classList.add('show');
            setTimeout(() => {
                pop.classList.remove('show');
            }, 900);
        }

        function spawnParticles(x, y, color) {
            for (let i = 0; i < 20; i++) {
                const p = document.createElement('div');
                p.className = 'particle';
                p.style.backgroundColor = color;
                p.style.left = x + 'px';
                p.style.top = y + 'px';

                const size = Math.random() * 8 + 4;
                p.style.width = size + 'px';
                p.style.height = size + 'px';

                const angle = Math.random() * Math.PI * 2;
                const dist = Math.random() * 120 + 30;
                p.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
                p.style.setProperty('--dy', `${Math.sin(angle) * dist}px`);

                document.body.appendChild(p);
                setTimeout(() => p.remove(), 1500);
            }
        }

        function promptAdminPass() {
            const pass = prompt('ادخل الرقم السري للوصول إلى سجل الدرجات:');
            if (pass === '2580') {
                renderAdminLog();
                openModal('adminModal');
            } else if (pass !== null) {
                alert('الرقم السري غير صحيح!');
            }
        }

        function saveGameRecord(isWin) {
            const records = JSON.parse(localStorage.getItem('doors_game_records') || '[]');
            const newRecord = {
                name: playerName,
                date: new Date().toLocaleString('ar-EG'),
                score: score,
                lives: lives,
                status: isWin ? 'فوز ✏️' : 'خسارة 💔'
            };
            records.push(newRecord);
            localStorage.setItem('doors_game_records', JSON.stringify(records));
        }

        function renderAdminLog() {
            const records = JSON.parse(localStorage.getItem('doors_game_records') || '[]');
            const tbody = document.getElementById('adminLogBody');
            tbody.innerHTML = '';

            if (records.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5">لا توجد سجلات مسجلة حتى الآن</td></tr>';
                return;
            }

            records.forEach(r => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${r.name}</td>
                    <td>${r.date}</td>
                    <td><strong>${r.score}</strong></td>
                    <td>${r.lives}</td>
                    <td>${r.status}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function clearScoreLog() {
            if (confirm('هل أنت تأكد من مسح جميع سجلات الطلاب؟')) {
                localStorage.removeItem('doors_game_records');
                renderAdminLog();
            }
        }

        function exportToCSV() {
            const records = JSON.parse(localStorage.getItem('doors_game_records') || '[]');
            if (records.length === 0) {
                alert('لا توجد بيانات لتصديرها!');
                return;
            }

            let csvContent = "\uFEFF";
            csvContent += "اسم الطالب,التاريخ,النقاط,الأرواح المتبقية,الحالة\n";

            records.forEach(r => {
                csvContent += `"${r.name}","${r.date}","${r.score}","${r.lives}","${r.status}"\n`;
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", `سجل_درجات_الأبواب_الغامضة_${Date.now()}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function openModal(id) {
            document.getElementById(id).classList.add('active');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        window.onload = function() {
            document.getElementById('studentNameInput').focus();
        };
    </script>
</body>
</html>
