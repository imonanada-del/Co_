    <script>
        // Web Audio Synthesizer
        let audioCtx = null;

        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function playSound(type) {
            try {
                const ctx = getAudioContext();
                if (!ctx) return;

                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);

                const now = ctx.currentTime;

                if (type === 'door') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(160, now);
                    osc.frequency.exponentialRampToValueAtTime(340, now + 0.35);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                } 
                else if (type === 'correct') {
                    const freqs = [523.25, 659.25, 783.99, 1046.50];
                    freqs.forEach((f, idx) => {
                        const subOsc = ctx.createOscillator();
                        const subGain = ctx.createGain();
                        subOsc.type = 'triangle';
                        subOsc.frequency.setValueAtTime(f, now + idx * 0.08);
                        subGain.gain.setValueAtTime(0.25, now + idx * 0.08);
                        subGain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.3);
                        subOsc.connect(subGain);
                        subGain.connect(ctx.destination);
                        subOsc.start(now + idx * 0.08);
                        subOsc.stop(now + idx * 0.08 + 0.3);
                    });
                } 
                else if (type === 'wrong') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.linearRampToValueAtTime(110, now + 0.35);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                } 
                else if (type === 'win') {
                    const notes = [523.25, 659.25, 783.99, 1046.5, 880, 1046.5];
                    notes.forEach((f, idx) => {
                        const subOsc = ctx.createOscillator();
                        const subGain = ctx.createGain();
                        subOsc.type = 'square';
                        subOsc.frequency.setValueAtTime(f, now + idx * 0.12);
                        subGain.gain.setValueAtTime(0.15, now + idx * 0.12);
                        subGain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.12 + 0.35);
                        subOsc.connect(subGain);
                        subGain.connect(ctx.destination);
                        subOsc.start(now + idx * 0.12);
                        subOsc.stop(now + idx * 0.12 + 0.35);
                    });
                }
            } catch (e) {
                console.log("Audio error:", e);
            }
        }

